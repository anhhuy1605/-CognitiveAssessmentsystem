# ==================================
# Environment Variables Template
# ==================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real secrets!

# ==================================
# Required for Production
# ==================================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-use-secrets-token-hex-32

# ==================================
# API Keys (Required)
# ==================================
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# ==================================
# Database (Optional - if using PostgreSQL)
# ==================================
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ==================================
# Server Configuration (Optional)
# ==================================
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
DEBUG=False

# ==================================
# Gunicorn Configuration (Optional)
# ==================================
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=300

# ==================================
# CORS Configuration (Optional)
# ==================================
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ==================================
# Feature Flags (Optional)
# ==================================
ENABLE_PAID_TRANSCRIPTION=true
TRANSCRIPTION_BUDGET_LIMIT=5.00
STORAGE_PATH=./storage

# ==================================
# Vietnamese ASR Model (Optional)
# ==================================
VI_ASR_MODEL=nguyenvulebinh/wav2vec2-large-vietnamese-250h
