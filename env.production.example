# ==================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==================================
# ⚠️  DO NOT COMMIT REAL SECRETS TO THIS FILE
# ⚠️  THIS IS ONLY A TEMPLATE WITH PLACEHOLDERS
#
# Instructions:
# 1. Copy this file: cp env.production.example .env.production
# 2. Replace all placeholder values with real credentials
# 3. Add to deployment platform (Vercel, Railway, etc.)
# 4. NEVER commit .env.production to Git!

# ==================================
# 🔴 CRITICAL - APP WON'T START WITHOUT THESE
# ==================================

# === DATABASE ===
# Get from: Neon Dashboard → Connection String
DATABASE_URL="postgresql://username:password@hostname:port/database?schema=public&pgbouncer=true&connect_timeout=15"

# === BACKEND SECURITY ===
# Generate with: python scripts/generate_secrets.py
SECRET_KEY="your_secret_key_here"

# === AI SERVICES ===
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your_openai_key_here"

# Google Gemini: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="AIzaSy-your_gemini_key_here"

# === AUTHENTICATION (Clerk) ===
# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key_here"

# === FILE STORAGE (Vercel Blob) ===
# Get from: Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_blob_token_here"

# ==================================
# 🟡 REQUIRED FOR CORE FEATURES
# ==================================

# === FRONTEND URLs ===
NEXT_PUBLIC_PYTHON_BACKEND_URL="https://your-railway-backend.up.railway.app"
NEXT_PUBLIC_APP_URL="https://your-vercel-frontend.vercel.app"

# === CORS ===
CORS_ORIGINS="https://your-vercel-frontend.vercel.app,https://your-vercel-frontend-git-main.vercel.app"

# ==================================
# ⚙️  CONFIGURATION
# ==================================

NODE_ENV="production"
FLASK_ENV="production"
LOG_LEVEL="info"
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=300

# ==================================
# 📝 WHERE TO GET EACH VALUE
# ==================================

# DATABASE_URL:
# - Sign up: https://neon.tech
# - Create database
# - Copy "Connection string" from dashboard

# SECRET_KEY:
# - Run: python scripts/generate_secrets.py
# - Copy the SECRET_KEY value

# OPENAI_API_KEY:
# - Sign up: https://platform.openai.com
# - API Keys section
# - Create new secret key

# GEMINI_API_KEY:
# - Sign up: https://makersuite.google.com
# - API Keys section
# - Create API key

# CLERK KEYS:
# - Sign up: https://dashboard.clerk.com
# - Create application
# - Copy from API Keys section

# BLOB_READ_WRITE_TOKEN:
# - In Vercel dashboard
# - Storage → Blob → Create
# - Copy token

# NEXT_PUBLIC_PYTHON_BACKEND_URL:
# - After deploying backend to Railway
# - Copy the Railway URL

# NEXT_PUBLIC_APP_URL:
# - After deploying frontend to Vercel
# - Copy the Vercel URL

# ==================================
# ✅ VALIDATION CHECKLIST
# ==================================

# Before deploying, verify:
# [ ] DATABASE_URL format correct (postgresql://...)
# [ ] SECRET_KEY is cryptographically random (not "password123")
# [ ] API keys start with correct prefixes (sk-, pk_, AIzaSy, etc.)
# [ ] URLs include https:// and no trailing slashes
# [ ] All placeholder values replaced with real credentials
# [ ] .env.production not in .gitignore (should be ignored)

# ==================================
# 🚨 SECURITY REMINDERS
# ==================================

# NEVER commit real secrets to Git
# NEVER share secrets via chat/email/screenshot
# NEVER use same secrets for staging/production
# ROTATE secrets every 90 days
# Use deployment platform's secret management
# Enable 2FA on all service accounts

# ==================================
# END OF FILE
# ==================================
